##
# Reset the target machine via Waveshare Modbus POE ETH Relay
#
# \param --power-on-waveshare-host    network address of device
# \param --power-on-waveshare-port    network port of device
# \param --power-on-waveshare-relay   relay channel number
#


proc power_on_waveshare_host { } {
	return [get_cmd_arg_first --power-on-waveshare-host localhost]
}


proc power_on_waveshare_port { } {
	return [get_cmd_arg_first --power-on-waveshare-port 0]
}


proc power_on_waveshare_channel { } {
	return [get_cmd_arg_first --power-on-waveshare-channel 0]
}


proc run_power_on { } {

	set    command \x00\x00
	append command \x00\x00
	append command [binary format S 6]
	append command \x01
	append command \x05
	append command [binary format S [expr [power_on_waveshare_channel]-1]]
	append command \xff\x00

	puts "switch relay channel [power_on_waveshare_channel] on"

	set fp [socket [power_on_waveshare_host] [power_on_waveshare_port]]
	fconfigure $fp -translation binary
	puts -nonewline $fp $command
	close $fp

	return true
}
